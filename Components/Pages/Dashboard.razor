@page "/dashboard"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using MyFirstAzureWebAppNet8.Data
@using MyFirstAzureWebAppNet8.Models
@inject NavigationManager NavigationManager

@inject CloudCanvasDbContext Context

<PageTitle>Dashboard</PageTitle>

<h1>CloudCanvasDashboard</h1>
<p class="page-intro">
    Welcome to the Cloud Canvas Dashboard! This is your central hub for tracking your Azure learning journey.
    Here you can quickly see an overview of your learning progress, access your learning entries, and find resources to help you along the way.
</p>

@if (isLoading)
{
    <p>
        Loading dashboard...
    </p>
}
else
{
    <div class="dashboard-grid">
        <div class="dashboard-card stat-card">
            <p class="stat-label">Total Learning Entries</p>
            <h2>@totalEntries</h2>
        </div>

        <div class="dashboard-card stat-card">
            <p class="stat-label">Categories Used</p>
            <h2>@totalCategories</h2>
        </div>

        <div class="dashboard-card quick-actions-card">
            <p class="stat-label">Quick Actions</p>

            <div class="dashboard-actions">
                <a href="/learning-entries/add" class="primary-btn">Add New Entry</a>
                <a href="/learning-entries" class="secondary-btn">View Entries</a>
            </div>
        </div>
    </div>

   <div class="dashboard-section">
        <h2>Recent Learning Entries</h2>

        @if (recentEntries == null)
        {
            <div class="empty-state">
                <h3>No learning entries yet</h3>
                <p>Start adding entries to see them listed here!</p>
            </div>
        }
        else
        {
            <div class="dashboard-card latest-entry-card">
                <div class="entry-meta">
                    <span class="entry-category">@recentEntries.Category</span>
                    <span class="entry-date">@recentEntries.DateCreated.ToLocalTime().ToString("dd/MMM/yyyy")</span>
                </div>

                <h3>@recentEntries.Title</h3>
                <p><strong>Module:</strong>@recentEntries.Module</p>
                <p><strong>Topic:</strong>@recentEntries.Topic</p>
                <p class="entry-content">@recentEntries.Content</p>

                @if (!String.IsNullOrWhiteSpace(recentEntries.Tags))
                {
                    <p class="entry-tags"><strong>Tags:</strong> @recentEntries.Tags</p>
                }
            </div>
        }
   </div>
}

@code 
{
    private bool isLoading = true;
    private int totalEntries;
    private int totalCategories;
    private LearningEntry? recentEntries;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        totalEntries = await Context.LearningEntries.CountAsync();
        totalCategories = await Context.LearningEntries.Select(e => e.Category).Distinct().CountAsync();
        recentEntries = await Context.LearningEntries.OrderByDescending(e => e.DateCreated).FirstOrDefaultAsync();

        isLoading = false;
    }
}
